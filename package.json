{
    "name": "php-in-js",
    "version": "1.1.0",
    "description": "A simple adaptation of php functions for javascript",
    "main": "cjs.js",
	"module": "es6.js",
	"types": "./types/index.d.ts",
  	"typings": "./types/index.d.ts",
	"exports": {
		".": {
			"import": "./es6.js",
			"require": "./cjs.js",
			"types": "./types/index.d.ts"
		}
	},
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dimtrovich/php-in-js.git"
    },
    "keywords": [
        "php",
        "pollyfil",
        "js",
        "php-in-js"
    ],
    "author": "Dimitri Sitchet <devcode.dst@gmail.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/dimtrovich/php-in-js/issues"
    },
    "homepage": "https://github.com/dimtrovich/php-in-js#readme",
	"scripts": {
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage"
  	},
  	"devDependencies": {
    	"jest": "^29.5.0"
    },
  	"jest": {
    	"testEnvironment": "node",
		"collectCoverageFrom": [
			"modules/*.js"
		]
	}
}
